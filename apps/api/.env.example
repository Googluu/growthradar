# Entorno
APP_ENV=development

# PostgreSQL — en Docker usa el hostname del servicio
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/growth_radar

# Redis — broker de Celery y caché
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
