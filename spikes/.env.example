# CrUX API — Google Cloud Console (growth.radar.app@gmail.com)
# Docs: https://developer.chrome.com/docs/crux/api
CRUX_API_KEY=your_google_cloud_api_key_here

# DataForSEO — cuenta registrada con correo laila
# Docs: https://docs.dataforseo.com
# El valor es Base64 de "email:password"
DATAFORSEO_API_KEY=your_dataforseo_basic_auth_base64_here

# Anthropic / Claude API
# Docs: https://docs.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
